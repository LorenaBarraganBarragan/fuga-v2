{
    "name": "fuga-plus-mobile",
    "version": "0.1.0",
    "private": true,
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.cjs",
        "test:coverage": "node --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=src/**/*.tsx --test-coverage-exclude=src/lib/notifications.ts --test tests/*.test.cjs"
    },
    "dependencies": {
        "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
        "@supabase/supabase-js": "^2.99.0",
        "expo": "~58.0.25",
        "expo-crypto": "~58.0.8",
        "expo-file-system": "~58.0.13",
        "expo-font": "~58.0.12",
        "expo-image-picker": "~58.0.10",
        "expo-notifications": "~58.1.9",
        "expo-secure-store": "~58.0.3",
        "expo-web-browser": "~58.0.8",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.1",
        "react-native-url-polyfill": "^2.0.0",
        "react-native-web": "~0.21.4"
    },
    "devDependencies": {
        "@types/react": "~19.3.0",
        "react-test-renderer": "19.3.0",
        "typescript": "~6.0.3"
    },
    "overrides": {
        "expo": "$expo",
        "minimatch": "^11.0.8"
    }
}
