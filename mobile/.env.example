# Mobile — Variables de entorno públicas
# Copiar como .env.local y completar.
# Solo variables EXPO_PUBLIC_* son inyectadas en el bundle;
# NUNCA poner DATABASE_URL ni service_role aquí.

# URL de la API FastAPI
# En emulador Android: http://10.0.2.2:8000
# En dispositivo físico: http://<IP-LAN>:8000
# En producción: https://<tu-hosting>/
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Supabase — solo URL y anon key (son públicas por diseño)
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon_key>
