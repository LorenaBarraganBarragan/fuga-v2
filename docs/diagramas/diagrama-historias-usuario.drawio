        <mxCell id="us10" value="&lt;b&gt;US10 &#183; Gestionar perfil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Como usuario, quiero actualizar mis datos personales para mantener mi informaci&#243;n actualizada.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Prioridad: Could&lt;/b&gt; &#183; Actor: Usuario&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1F1F1F;" vertex="1" parent="mod1">
