          <mxGeometry as="geometry" x="70" y="1030" width="1660" height="170" />
        </mxCell>
        <mxCell id="p1_legend_text" value="&lt;b style=&quot;font-size:11px;color:#0F172A;&quot;&gt;Leyenda y lectura&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.2px;color:#475569;&quot;&gt;Estado: &lt;b style=&quot;color:#166534;&quot;&gt;■ Implementada 0&lt;/b&gt; · &lt;b style=&quot;color:#1D4ED8;&quot;&gt;■ En desarrollo 0&lt;/b&gt; · &lt;b style=&quot;color:#334155;&quot;&gt;■ Pendiente 31&lt;/b&gt; · &lt;b style=&quot;color:#92400E;&quot;&gt;■ Postergada 2&lt;/b&gt; · &lt;b style=&quot;color:#64748B;&quot;&gt;■ Propuesta 0&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.2px;color:#475569;&quot;&gt;Prioridad: &lt;b style=&quot;color:#991B1B;&quot;&gt;■ Must 13&lt;/b&gt; · &lt;b style=&quot;color:#1E40AF;&quot;&gt;■ Should 9&lt;/b&gt; · &lt;b style=&quot;color:#166534;&quot;&gt;■ Could 9&lt;/b&gt; · &lt;b style=&quot;color:#374151;&quot;&gt;■ Won't 2&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.2px;color:#475569;&quot;&gt;Actor: &lt;b style=&quot;color:#166534;&quot;&gt;■ Visitante 2&lt;/b&gt; · &lt;b style=&quot;color:#1D4ED8;&quot;&gt;■ Usuario 28&lt;/b&gt; · &lt;b style=&quot;color:#6D28D9;&quot;&gt;■ Administrador 3&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8.5px;color:#64748B;&quot;&gt;Vínculos = relaciones HU documentadas (prerrequisitos y habilitaciones). No se marca ninguna HU como implementada porque no hay código FUGA+ verificable. Fuente: docs/respuestas-ia/salida-historias-usuario.md.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="1">
