        <mxCell id="us05" value="&lt;b&gt;US05 &#183; Consultar historial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Como usuario, quiero consultar mi historial de gastos para conocer en qu&#233; he utilizado mi dinero.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Prioridad: Must&lt;/b&gt; &#183; Actor: Usuario&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1F1F1F;" vertex="1" parent="mod2">
