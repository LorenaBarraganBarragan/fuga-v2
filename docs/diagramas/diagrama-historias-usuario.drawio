        <mxCell id="us04" value="&lt;b&gt;US04 &#183; Interpretar gasto&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Como usuario, quiero que el sistema interprete el texto de mi gasto para identificar el valor, la categor&#237;a y la descripci&#243;n.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;&lt;b&gt;Prioridad: Must&lt;/b&gt; &#183; Actor: Usuario&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#1F1F1F;" vertex="1" parent="mod2">
