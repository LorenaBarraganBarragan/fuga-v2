;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontStyle=1;fontColor=#991B1B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="1100" height="250" as="geometry"/></mxCell><mxCell id="g_alerts" value="Alertas y sugerencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FBBF24;fontSize=12;fontStyle=1;fontColor=#92400E;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="800" width="1100" height="180" as="geometry"/></mxCell><mxCell id="usuario" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="100" y="500" width="90" height="90" as="geometry"/></mxCell><mxCell id="uc22" value="UC-22&#xa;Consultar gastos por&#xa;categoría" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc21" value="UC-21&#xa;Consultar dashboard&#xa;personal" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc23" value="UC-23&#xa;Comparar períodos" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="290" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc25" value="UC-25&#xa;Consultar evidencias&#xa;de una posible fuga" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="600" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc24" value="UC-24&#xa;Detectar posibles&#xa;fugas de dinero" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="600" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc26" value="UC-26&#xa;Consultar resumen mensual&#xa;de posibles fugas" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1030" y="600" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc27" value="UC-27&#xa;Consultar alertas de&#xa;posibles fugas" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="680" y="850" width="280" height="110" as="geometry"/></mxCell><mxCell id="uc28" value="UC-28&#xa;Consultar sugerencias&#xa;prácticas" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#334155;fillColor=#FFFFFF;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="850" width="280" height="110" as="geometry"/></mxCell><mxCell id="note" value="Reglas y alcance&#xa;• Las posibles fugas se detectan con reglas deterministas; no son predicciones de IA.&#xa;• Las evidencias muestran ocurrencias y monto acumulado; no se inventan umbrales.&#xa;• Las alertas son consultas dentro de la app; no se incluyen notificaciones avanzadas.&#xa;• Las sugerencias son orientativas y no constituyen asesoría financiera.&#xa;• UC-29 y UC-30 (metas mensuales) no se incluyen: HU-28 y HU-29 no están priorizadas actualmente.&#xa;• Cada Usuario solo accede a sus gastos y anális