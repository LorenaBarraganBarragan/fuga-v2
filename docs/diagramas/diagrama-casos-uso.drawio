06;fontSize=10;fontColor=#78350F;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;size=12;" vertex="1" parent="1"><mxGeometry x="1120" y="840" width="580" height="140" as="geometry"/></mxCell><mxCell id="note" value="Reglas del flujo de gastos&#xa;• El botón «Procesar con IA» usa diccionario y reglas deterministas, sin una API externa de IA.&#xa;• La voz solo está disponible en Android (Kotlin SpeechRecognizer); la transcripción es editable.&#xa;• Editar o eliminar un gasto actualiza los resúmenes y análisis afectados.&#xa;• Cada Usuario accede únicamente a sus propios gastos." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=10;fontColor=#78350F;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=8;size=12;" vertex="1" parent="1"><mxGeometry x="320" y="1080" width="1460" height="100" as="geometry"/></mxCell><mxCell id="a_u_uc11" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="usuario" target="uc11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="565"/><mxPoint x="220" y="355"/></Array></mxGeometry></mxCell><mxCell id="a_u_uc13" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="usuario" target="uc13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="565"/><mxPoint x="250" y="240"/><mxPoint x="1060" y="240"/><mxPoint x="1060" y="355"/></Array></mxGeometry></mxCell><mxCell id="a_u_uc14" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#475569;strokeWidth=1.2;edgeStyle=orthogonalEdgeStyle;jettySize=auto;orthogonalLoop=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1"