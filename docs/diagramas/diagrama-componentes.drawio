        </mxCell>

        <mxCell id="streams" value="&lt;b&gt;«module» (opcional)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Cambios en tiempo real&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología:&lt;/b&gt; MongoDB Change Streams&lt;br&gt;&lt;b&gt;(opcional)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Actualizar la información cuando cambien los datos.&lt;br&gt;&lt;br&gt;• Escucha cambios en las colecciones&lt;br&gt;• Avisa al backend para refrescar la vista&lt;br&gt;• Componente opcional del proyecto" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaDatos">
          <mxGeometry x="40" y="55" width="280" height="250" as="geometry" />
        </mxCell>
        <mxCell id="streams_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="26" y="85" width="14" height="36" as="geometry" />
        </mxCell>
        <mxCell id="streams_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="26" y="185" width="14" height="36" as="geometry" />
        </mxCell>

        <mxCell id="mongo" value="&lt;b&gt;«database»&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: MongoDB&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Usuarios, gastos, categorías, historial y estadísticas.&lt;br&gt;&lt;br&gt;&lt;b&gt;Datos lógicos almacenados:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Usuarios&lt;/b&gt; — credenciales, rol y estado de la cuenta&lt;br&gt;• &lt;b&gt;Gastos&lt;/b&gt; — monto, moneda, categoría, descripción, fecha y propietario&lt;br&gt;• &lt;b&gt;Categorías&lt;/b&gt; — categorías predefinidas del sistema&lt;br&gt;• &lt;b&gt;Historial&lt;/b&gt; — gastos confirmados del usuario&lt;br&gt;• &lt;b&gt;Estadísticas&lt;/b&gt; — totales, promedios y comparaciones de periodos&lt;br&gt;&lt;br&gt;Cada gasto pertenece a exactamente un usuario." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#D0E0E3;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaDatos">
          <mxGeometry x="340" y="55" width="620" height="250" as="geometry" />
        </mxCell>
        <mxCell id="mongo_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D0E0E3;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="326" y="88" width="14" height="38" as="geometry" />
        </mxCell>
        <mxCell id="mongo_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D0E0E3;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="326" y="195" width="14" height="38" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&lt;b&gt;«database» Caché&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: Redis&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Caché, sesiones/datos temporales y consultas frecuentes.&lt;br&gt;• Resultados de consultas repetidas&lt;br&gt;• Datos temporales de sesión" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=9;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaDatos">
