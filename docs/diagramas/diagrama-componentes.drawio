          <mxGeometry x="326" y="358" width="14" height="32" as="geometry" />
        </mxCell>
        <mxCell id="redis_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="326" y="415" width="14" height="32" as="geometry" />
        </mxCell>

        <mxCell id="aggregation" value="&lt;b&gt;«module» Consultas y estadísticas&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología:&lt;/b&gt; MongoDB Aggregation&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Totales por categoría, estadísticas y análisis del dashboard.&lt;br&gt;• Totales y acumulados por categoría&lt;br&gt;• Promedios de gasto&lt;br&gt;• Comparación de periodos" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=9;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaDatos">
