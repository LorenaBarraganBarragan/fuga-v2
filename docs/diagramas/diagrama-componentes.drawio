        <mxCell id="jwt_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="capaBackend">
          <mxGeometry x="706" y="180" width="14" height="36" as="geometry" />
        </mxCell>

        <mxCell id="capaInfra" value="E. INFRAESTRUCTURA" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
