                <mxCell id="NOTAS" parent="1" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;arcSize=4;fillColor=#F5F5F5;swimlaneFillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontStyle=1;fontColor=#333333;align=left;spacingLeft=12;whiteSpace=wrap;" value="Notas de la arquitectura" vertex="1">
