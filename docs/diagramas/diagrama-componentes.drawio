        <mxCell id="aggregation_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="capaDatos">
          <mxGeometry x="646" y="415" width="14" height="32" as="geometry" />
        </mxCell>

        <mxCell id="capaIA" value="C. SERVICIOS DE IA" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#9673A6;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="1160" y="920" width="560" height="480" as="geometry" />
