        <mxCell id="docker" value="&lt;b&gt;«node» Contenedores&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: Docker + Docker Compose&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Ejecutar backend, MongoDB y Redis de forma organizada.&lt;br&gt;&lt;br&gt;&lt;i&gt;Contiene y ejecuta los siguientes servicios:&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaInfra">
