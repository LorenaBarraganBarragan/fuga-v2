        <mxCell id="openai" value="&lt;b&gt;«service»&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Servicio de IA&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: OpenAI API&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Extraer monto, categoría y descripción de los gastos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ejemplo de interpretación&lt;/b&gt;&lt;br&gt;Texto: &amp;quot;Hoy gasté $8.000 en un taxi&amp;quot;&lt;br&gt;Resultado:&lt;br&gt;  monto: 8000&lt;br&gt;  categoría: Transporte&lt;br&gt;  descripción: Taxi&lt;br&gt;&lt;br&gt;&lt;b&gt;Límites del componente&lt;/b&gt;&lt;br&gt;• No detecta fugas de dinero.&lt;br&gt;• No predice fugas de dinero.&lt;br&gt;• No da asesoría financiera.&lt;br&gt;• No predice mercados." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaIA">
          <mxGeometry x="60" y="70" width="440" height="360" as="geometry" />
        </mxCell>
        <mxCell id="openai_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="capaIA">
          <mxGeometry x="46" y="100" width="14" height="38" as="geometry" />
        </mxCell>
        <mxCell id="openai_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="capaIA">
          <mxGeometry x="46" y="290" width="14" height="38" as="geometry" />
        </mxCell>

        <mxCell id="capaDesarrollo" value="F. DESARROLLO Y DOCUMENTACIÓN" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#999999;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
