          <mxGeometry x="40" y="62" width="1200" height="26" as="geometry" />
        </mxCell>

        <mxCell id="capaPresentacion" value="A. PRESENTACIÓN" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="1000" height="430" as="geometry" />
        </mxCell>

        <mxCell id="visitante" value="&lt;b&gt;«actor» Visitante&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sin cuenta.&lt;br&gt;Accede solo a la información general." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;fontColor=#333333;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="20" y="45" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="usuario" value="&lt;b&gt;«actor» Usuario&lt;/b&gt;&lt;br&gt;&lt;br&gt;Registrado. Gestiona sus gastos, historial y dashboard." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="260" y="45" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;«actor» Administrador&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gestiona cuentas y consulta estadísticas agregadas." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="500" y="45" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="app" value="&lt;b&gt;«component»&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aplicación móvil FUGA+&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: React Native + TypeScript&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Interfaz de FUGA+ para visitantes y usuarios.&lt;br&gt;&lt;br&gt;• Registro de gastos en lenguaje natural&lt;br&gt;• Historial de gastos y categorías&lt;br&gt;• Dashboard personal y posibles fugas&lt;br&gt;• Comparación de periodos&lt;br&gt;• Alertas dentro de la aplicación&lt;br&gt;• Conserva el token JWT y lo envía en cada solicitud" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="20" y="160" width="700" height="250" as="geometry" />
        </mxCell>
        <mxCell id="app_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="6" y="190" width="14" height="40" as="geometry" />
        </mxCell>
        <mxCell id="app_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="6" y="280" width="14" height="40" as="geometry" />
        </mxCell>

        <mxCell id="leyenda" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Caja con dos pestañas: componente UML.&lt;br&gt;• «actor»: rol que usa la aplicación.&lt;br&gt;• Flecha con etiqueta: tecnología o propósito del vínculo.&lt;br&gt;• Línea punteada: componente opcional o de desarrollo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Flujo principal&lt;/b&gt;&lt;br&gt;React Native + TypeScript&lt;br&gt;↓ HTTPS / JSON&lt;br&gt;Python + FastAPI&lt;br&gt;↓ Persistencia&lt;br&gt;MongoDB&lt;br&gt;&lt;br&gt;El backend también invoca OpenAI API (interpretación), JWT (autenticación), Redis (caché) y MongoDB Aggregation (estadísticas)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;fontSize=9;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontColor=#333333;" vertex="1" parent="capaPresentacion">
          <mxGeometry x="740" y="160" width="240" height="250" as="geometry" />
        </mxCell>

        <mxCell id="capaBackend" value="B. BACKEND" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1000" height="320" as="geometry" />
        </mxCell>
        <mxCell id="fastapi" value="&lt;b&gt;«component»&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;API / Backend&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: Python + FastAPI&lt;/b&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; API, lógica del sistema, autenticación y conexión entre componentes.&lt;br&gt;&lt;br&gt;• Endpoints REST con especificación OpenAPI&lt;br&gt;• Validación de datos y reglas de negocio&lt;br&gt;• Gestión de usuarios, gastos y categorías&lt;br&gt;• Coordinación de la interpretación con IA&lt;br&gt;• Orquestación de la detección de posibles fugas&lt;br&gt;• Consulta de estadísticas para el dashboard" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;spacingRight=10;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaBackend">
          <mxGeometry x="40" y="45" width="660" height="240" as="geometry" />
        </mxCell>
        <mxCell id="fastapi_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="capaBackend">
          <mxGeometry x="26" y="75" width="14" height="38" as="geometry" />
        </mxCell>
        <mxCell id="fastapi_tab2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="capaBackend">
          <mxGeometry x="26" y="170" width="14" height="38" as="geometry" />
        </mxCell>

        <mxCell id="jwt" value="&lt;b&gt;«service»&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Autenticación&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tecnología: JWT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Propósito:&lt;/b&gt; Identificar usuarios y diferenciar Usuario/Administrador.&lt;br&gt;&lt;br&gt;• Inicio de sesión&lt;br&gt;• Generación de token&lt;br&gt;• Validación de token&lt;br&gt;• Autorización por rol&lt;br&gt;• Protección de endpoints" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="capaBackend">
          <mxGeometry x="720" y="60" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="jwt_tab1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="capaBackend">
          <mxGeometry x="706" y="88" width="14" height="36" as="geometry" />
