        <mxCell id="de1" value="contiene" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=6 6;strokeWidth=1;strokeColor=#9673A6;fontSize=9;fontColor=#9673A6;labelBackgroundColor=#FFFFFF;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="docker" target="docker_fastapi">
