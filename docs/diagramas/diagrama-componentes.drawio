        <mxCell id="capaDatos" value="D. DATOS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=18;spacingTop=10;fontSize=17;fontStyle=1;fillColor=none;strokeColor=#6C8EBF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="1">
