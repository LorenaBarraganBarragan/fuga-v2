        <mxCell id="leyenda" value="&lt;b&gt;Convenciones&lt;/b&gt;&lt;br&gt;&#8212;&#160;&#160;atributo privado&#160;&#160;/&#160;&#160;&#160;+ m&#233;todo p&#250;blico&#10;&#8212;&#160;&#160;asociaci&#243;n 1 : 0..*&#10;- - -&gt;&#160;&#160;dependencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#444444;" vertex="1" parent="1">
