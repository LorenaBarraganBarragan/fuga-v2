        <mxCell id="jerarquia" value="&lt;b&gt;«note» Estructura en MongoDB&lt;/b&gt;&lt;br&gt;&lt;br&gt;MongoDB&lt;br&gt;↓ Colecciones&lt;br&gt;↓ Documentos / atributos&lt;br&gt;↓ Referencias entre documentos&lt;br&gt;&lt;br&gt;&lt;i&gt;usuarioId · categoriaId · fugaId&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1120" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="leyenda" value="&lt;b&gt;«note» Leyenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;font color=&quot;#B85450&quot;&gt;&lt;b&gt;(PK)&lt;/b&gt;&lt;/font&gt; — Clave primaria / identificador del documento&lt;br&gt;• &lt;font color=&quot;#9673A6&quot;&gt;&lt;b&gt;Ref. colección._id&lt;/b&gt;&lt;/font&gt; — Referencia a un documento de otra colección&lt;br&gt;• &lt;b&gt;1&lt;/b&gt; — Un registro relacionado&lt;br&gt;• &lt;b&gt;N&lt;/b&gt; — Varios registros relacionados&lt;br&gt;• No se usan claves foráneas: MongoDB no es una base de datos relacional." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="1120" width="380" height="170" as="geometry" />
        </mxCell>

        <mxCell id="nota" value="&lt;b&gt;«note» Nota&lt;/b&gt;&lt;br&gt;&lt;br&gt;FUGA+ utiliza MongoDB. Las colecciones almacenan documentos y las referencias mediante usuarioId, categoriaId y fugaId relacionan documentos entre colecciones." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=10;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#333333;" vertex="1" parent="1">
