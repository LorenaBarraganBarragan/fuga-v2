# Backend — Variables de entorno
# Copiar como .env.local y completar con valores reales.
# NUNCA commitear el archivo con valores reales.

# Entorno de ejecución: local | test | prod
APP_ENV=local

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supabase — obtener en el panel del proyecto
SUPABASE_URL=https://<ref>.supabase.co
# JWKS e issuer se derivan de la URL raíz; no es necesario definirlos.
SUPABASE_JWT_AUDIENCE=authenticated

# Base de datos — usar el pooler de sesión (puerto 5432) en desarrollo
# Formato: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password_urlencoded>@<host_session_pooler>:5432/postgres?sslmode=verify-full
# Ruta relativa al backend, también portable en Linux. El certificado es público.
DATABASE_SSL_ROOT_CERT=certs/prod-ca-2021.crt
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Clave sb_secret_ o legacy service_role, enviada por apikey; nunca JWT de usuario.
# Solo para operaciones admin — NUNCA en el móvil.
SUPABASE_SERVICE_ROLE_KEY=

# CORS — lista JSON
# En móvil nativo no aplica, pero restringir en producción
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# Cloudinary (Should — no requerido en MVP)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Pruebas: solo PostgreSQL local desechable; nunca usar Supabase remoto.
# Exportar en la terminal de pruebas, no es una conexión de la aplicación:
# FUGA_TEST_DATABASE_URL="host=127.0.0.1 port=55439 user=fuga_test dbname=postgres"
