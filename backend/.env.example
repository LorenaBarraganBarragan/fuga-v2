# Backend — Variables de entorno
# Copiar como .env.local y completar con valores reales.
# NUNCA commitear el archivo con valores reales.

# Entorno de ejecución: local | test | prod
APP_ENV=local

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Supabase — obtener en el panel del proyecto
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Base de datos — usar el pooler de sesión (puerto 5432) en desarrollo
# Formato: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# Clave de servicio (solo para operaciones admin — NUNCA en el móvil)
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# CORS — separar con coma si hay varios orígenes
# En móvil nativo no aplica, pero restringir en producción
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Cloudinary (Should — no requerido en MVP)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Base de datos de pruebas (Test) — proyecto Supabase separado
# TEST_DATABASE_URL=postgresql+psycopg://...
