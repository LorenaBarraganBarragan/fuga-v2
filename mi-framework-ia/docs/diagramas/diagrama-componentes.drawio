        <mxCell id="hdr-sub" value="Arquitectura de ejecución · Especificación 3.0 · React Native/TypeScript · FastAPI/Python · Supabase PostgreSQL · Supabase Auth" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5E7683;" vertex="1" parent="1">
