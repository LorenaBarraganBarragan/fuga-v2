        <mxCell id="p5-s" value="Módulo 8 — HU-30 a HU-33 · Actores: Administrador y Usuario · 4 casos de uso" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=11;fontColor=#5E7683;" vertex="1" parent="1"><mxGeometry x="68" y="68" width="1180" height="22" as="geometry"/></mxCell>
        <mxCell id="p5-rule" value="" style="rounded=0;html=1;fillColor=#DCE7EC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="48" y="100" width="1504" height="1" as="geometry"/></mxCell>
        <mxCell id="p5-foot" value="FUGA+ · Especificación 3.0 · Diagrama de casos de uso UML" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9;fontColor=#8AA0AC;" vertex="1" parent="1"><mxGeometry x="48" y="946" width="1200" height="18" as="geometry"/></mxCell>
        <mxCell id="sys5" value="Sistema FUGA+" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCFEFF;strokeColor=#A9C6D3;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#2F7A8C;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="780" height="620" as="geometry"/></mxCell>
        <mxCell id="sec-m8" value="MÓDULO 8 · ADMINISTRACIÓN Y PRIVACIDAD" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=9;fontStyle=1;fontColor=#7C93A0;spacingLeft=2;" vertex="1" parent="1"><mxGeometry x="472" y="168" width="560" height="20" as="geometry"/></mxCell>
        <mxCell id="uc-HU-30" value="&lt;b&gt;Consultar estadísticas agregadas de uso&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-30 · RF-030 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="194" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-31" value="&lt;b&gt;Consultar usuarios e información administrativa&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-31 · RF-031 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="302" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-32" value="&lt;b&gt;Activar o desactivar cuentas de usuario&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-32 · RF-032 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="410" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-33" value="&lt;b&gt;Proteger la privacidad y el aislamiento de los gastos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-33 · RF-033 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="518" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="a-adm5" value="&lt;b&gt;Administrador&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#12444F;fillColor=#FFFFFF;strokeColor=#2F7A8C;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="150" y="304" width="44" height="80" as="geometry"/></mxCell>
        <mxCell id="a-usr5" value="&lt;b&gt;Usuario&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#12444F;fillColor=#FFFFFF;strokeColor=#2F7A8C;strokeWidth=1.8;" vertex="1" parent="1"><mxGeometry x="150" y="520" width="44" height="80" as="geometry"/></mxCell>
        <mxCell id="e5a-HU-30" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-adm5" target="uc-HU-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5a-HU-31" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-adm5" target="uc-HU-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5a-HU-32" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-adm5" target="uc-HU-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5a-HU-33" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-adm5" target="uc-HU-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e5u-HU-33" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-usr5" target="uc-HU-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x5-1" value="«extend»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-32" target="uc-HU-31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="435.2"/><mxPoint x="1090" y="344.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n5-1" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Privacidad administrativa (D-07)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Los agregados solo se muestran con 10 o más usuarios distintos; se suprimen los grupos menores y no se exponen identificadores ni importes individuales.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="196" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="n5-2" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Aislamiento (HU-33 / RF-033)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;La identidad se deriva del token de Supabase Auth; FastAPI valida firma, vigencia, rol y propiedad, con RLS o filtrado explícito. Un Administrador nunca ve gastos individuales.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="386" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="n5-3" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Auditoría (D-14)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Se registran consultas de listado, cambios de estado de cuenta y fallos de autorización con fecha UTC, actor y cuenta objetivo, sin datos financieros.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="586" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="perm-panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE7EC;strokeWidth=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="48" y="700" width="700" height="230" as="geometry"/></mxCell>
        <mxCell id="perm-t" value="&lt;b&gt;Actores y alcance de acceso (D-08)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#12444F;" vertex="1" parent="1"><mxGeometry x="68" y="712" width="400" height="22" as="geometry"/></mxCell>
        <mxCell id="perm-r0" value="&lt;b&gt;Visitante&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#26697D;" vertex="1" parent="1"><mxGeometry x="68" y="744" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="perm-d0" value="Acceso público, registro e inicio de sesión. Nunca recibe datos financieros ni un token por abrir la pantalla." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#4F6B78;" vertex="1" parent="1"><mxGeometry x="190" y="744" width="540" height="44" as="geometry"/></mxCell>
        <mxCell id="perm-r1" value="&lt;b&gt;Usuario&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#26697D;" vertex="1" parent="1"><mxGeometry x="68" y="800" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="perm-d1" value="Solo sus propios gastos, estadísticas, posibles fugas y perfil. Toda consulta se filtra por propietario." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#4F6B78;" vertex="1" parent="1"><mxGeometry x="190" y="800" width="540" height="44" as="geometry"/></mxCell>
        <mxCell id="perm-r2" value="&lt;b&gt;Administrador&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#26697D;" vertex="1" parent="1"><mxGeometry x="68" y="856" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="perm-d2" value="Metadatos de cuentas y agregados no identificables. No accede a gastos, evidencias ni importes personales." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#4F6B78;" vertex="1" parent="1"><mxGeometry x="190" y="856" width="540" height="44" as="geometry"/></mxCell>
        <mxCell id="n5-4" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Trazabilidad de esta vista&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;HU-30, HU-31 y HU-32 son Should Have y quedan fuera del MVP. HU-33 es Must Have y transversal a todos los casos de uso privados de las páginas 02 a 04.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="772" y="700" width="452" height="110" as="geometry"/></mxCell>
        <mxCell id="n5-5" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Reglas de solo consulta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;HU-31 no permite modificar usuarios y HU-32 exige confirmación, impide la autodesactivación del administrador y audita cada cambio de estado.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="772" y="826" width="452" height="104" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
