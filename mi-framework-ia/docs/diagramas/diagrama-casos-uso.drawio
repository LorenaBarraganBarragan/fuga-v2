        <mxCell id="uc-HU-01" value="&lt;b&gt;Consultar información pública, registro e inicio de sesión&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-01 · RF-001 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="194" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-02" value="&lt;b&gt;Registrarse e iniciar sesión con correo y contraseña&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-02 · RF-002 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="298" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-03" value="&lt;b&gt;Iniciar sesión con una cuenta de Google&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-03 · RF-003 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="402" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-04" value="&lt;b&gt;Cerrar sesión de forma segura&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-04 · RF-004 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="506" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-05" value="&lt;b&gt;Recuperar el acceso restableciendo la contraseña&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-05 · RF-005 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-06" value="&lt;b&gt;Desactivar la propia cuenta de usuario&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-06 · RF-006 · Could Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#FCF0DC;strokeColor=#C49A5C;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="714" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-07" value="&lt;b&gt;Consultar y editar nombres y teléfono del perfil&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-07 · RF-007 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="852" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-08" value="&lt;b&gt;Cambiar la foto de perfil&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-08 · RF-008 · Should Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#E4F1E7;strokeColor=#5E9C77;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="956" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-09" value="&lt;b&gt;Usar la foto de perfil de Google&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-09 · RF-009 · Could Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#FCF0DC;strokeColor=#C49A5C;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="1060" width="560" height="84" as="geometry"/></mxCell>
