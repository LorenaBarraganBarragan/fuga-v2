        <mxCell id="e2u2" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-usr2" target="uc-HU-07"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2u3" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-usr2" target="uc-HU-08"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e2u4" value="" style="endArrow=none;html=1;edgeStyle=none;strokeColor=#4E6E7C;strokeWidth=1.3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a-usr2" target="uc-HU-09"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="x2-1" value="«extend»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-09" target="uc-HU-07"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1085.2"/><mxPoint x="1090" y="894.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n2-1" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Supabase Auth (D-09)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Gestiona el registro, la sesión y el restablecimiento. FastAPI valida el token y el rol; el cliente nunca decide identidad ni rol. El registro público siempre crea rol Usuario.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="196" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="n2-2" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Google OAuth (D-10)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Should Have: exige credenciales, URI de redirección y consentimiento configurados. Si falla, el acceso por correo y contraseña sigue disponible.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="376" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="n2-3" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Perfil (D-13)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Nombres de 2 a 80 caracteres y teléfono colombiano opcional de 10 dígitos. Solo se consulta y edita el perfil propio; otra cuenta responde 403/404 sin datos.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="546" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="n2-4" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Foto de perfil (D-13)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;JPEG/PNG/WebP de hasta 5 MB mediante Cloudinary con firma o endpoint del backend, sin exponer secretos en el cliente. La foto cargada manualmente tiene precedencia.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="726" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="n2-5" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Cierre y desactivación&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Al cerrar sesión se elimina la sesión local y se solicita la revocación. Una cuenta desactivada no puede iniciar sesión y sus sesiones se invalidan (D-06 / D-09).&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="906" width="300" height="150" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
