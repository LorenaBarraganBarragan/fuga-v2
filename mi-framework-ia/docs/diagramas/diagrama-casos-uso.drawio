        <mxCell id="uc-HU-26" value="&lt;b&gt;Consultar sugerencias prácticas sobre las fugas&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-26 · RF-026 · Could Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#FCF0DC;strokeColor=#C49A5C;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="890" width="560" height="84" as="geometry"/></mxCell>
