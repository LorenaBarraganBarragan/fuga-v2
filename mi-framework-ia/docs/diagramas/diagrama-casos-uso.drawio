        <mxCell id="x3-3" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-12" target="uc-HU-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="435.2"/><mxPoint x="1090" y="560.0"/></Array></mxGeometry></mxCell>
        <mxCell id="x3-4" value="«extend»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-15" target="uc-HU-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="759.2"/><mxPoint x="1090" y="668.0"/></Array></mxGeometry></mxCell>
        <mxCell id="x3-5" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-17" target="uc-HU-18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="999.2"/><mxPoint x="1090" y="1124.0"/></Array></mxGeometry></mxCell>
        <mxCell id="x3-6" value="«include»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-18" target="uc-HU-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1107.2"/><mxPoint x="1090" y="1232.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n3-1" value="&lt;b style='font-size:10px;color:#5C5236'&gt;«Procesar con IA» (D-05 / RNF-010)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Es la etiqueta visible del botón. La interpretación usa un diccionario y reglas deterministas versionadas, sin API externa de IA generativa.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="196" width="300" height="158" as="geometry"/></mxCell>
        <mxCell id="n3-2" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Borrador en memoria&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;El texto admite de 1 a 280 caracteres. El borrador solo vive en la pantalla y se descarta al abandonarla: no se persisten borradores incompletos.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="376" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="n3-3" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Revisión obligatoria (D-02 / D-03 / D-04)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Monto entero entre COP 1 y 100.000.000, categoría del catálogo cerrado y fecha entre 2020-01-01 y hoy. Las validaciones se repiten en el backend.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="548" width="300" height="168" as="geometry"/></mxCell>
        <mxCell id="n3-4" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Guardado aislado (RF-013)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Operación atómica e idempotente: el propietario se deriva del token y la clave UUID por intento se conserva 24 horas. Un gasto ajeno responde 403/404 sin datos.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="738" width="300" height="158" as="geometry"/></mxCell>
        <mxCell id="n3-5" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Historial (D-04)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Orden fecha_gasto DESC, created_at DESC e id DESC, con paginación sin duplicados ni omisiones y estado vacío con acción para registrar el primer gasto.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="918" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="n3-6" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Voz (D-12)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Solo Android con Kotlin SpeechRecognizer, idioma es-CO, máximo 30 segundos y 280 caracteres editables. El audio no se almacena ni se envía a servicios no aprobados.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="1090" width="300" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
