        <mxCell id="ta-h0" value="&lt;b&gt;HU&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#12444F;strokeColor=#0E353E;fontColor=#FFFFFF;fontSize=10;fontStyle=1;align=center;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="48" y="150" width="66" height="32" as="geometry"/></mxCell>
