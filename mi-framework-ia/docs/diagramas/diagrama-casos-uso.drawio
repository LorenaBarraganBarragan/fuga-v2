        <mxCell id="legr2" value="&lt;b&gt;Could Have&lt;/b&gt; — ampliación especificada" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#3B5560;" vertex="1" parent="1"><mxGeometry x="1276" y="324" width="270" height="20" as="geometry"/></mxCell>
