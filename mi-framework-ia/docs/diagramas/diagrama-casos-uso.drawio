        <mxCell id="x4-3" value="«extend»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endSize=8;dashed=1;dashPattern=6 4;strokeColor=#7E93A0;strokeWidth=1.2;fontSize=9;fontColor=#546B78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="uc-HU-29" target="uc-HU-28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1239.2"/><mxPoint x="1090" y="1148.0"/></Array></mxGeometry></mxCell>
        <mxCell id="n4-1" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Dashboard (D-04)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Mes calendario actual en America/Bogota. Total, cantidad y promedio; el promedio es el total dividido entre la cantidad y, con cantidad cero, se muestra estado sin datos.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="196" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="n4-2" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Categorías (D-02 / D-03)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Catálogo cerrado de nueve categorías, con «Otros» siempre incluido. En empates se muestran todas las categorías empatadas y los porcentajes usan un decimal.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="376" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="n4-3" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Regla FUGA-01 v1.0 (D-01)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Últimos 30 días: al menos 3 gastos en 3 fechas distintas, entre COP 1.000 y 30.000, con suma mínima de COP 15.000. Resultado determinista y explicable.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="556" width="300" height="168" as="geometry"/></mxCell>
        <mxCell id="n4-4" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Evidencia (D-15)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;La posible fuga nunca se presenta como pérdida confirmada: se muestran regla, versión, ocurrencias, rango de fechas y los gastos propios que la sustentan.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="744" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="n4-5" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Alertas (D-11)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;Una notificación local por candidato y versión de regla cada 7 días, sin push remoto y sin datos financieros en pantalla bloqueada. La alerta interna siempre está disponible.&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="924" width="300" height="168" as="geometry"/></mxCell>
        <mxCell id="n4-6" value="&lt;b style='font-size:10px;color:#5C5236'&gt;Límite mensual&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#6B6350'&gt;HU-28 y HU-29 son Won't Have: se documentan para evolución, pero no se implementan en esta versión de la línea base (D-06).&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fillColor=#FFFCF2;strokeColor=#E0D2B2;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontFamily=Helvetica;fontSize=10;fontColor=#4F4A3C;" vertex="1" parent="1"><mxGeometry x="1240" y="1112" width="300" height="140" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
