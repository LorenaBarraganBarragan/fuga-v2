        <mxCell id="uc-HU-20" value="&lt;b&gt;Consultar total, cantidad y promedio por periodo&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-20 · RF-020 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="194" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-21" value="&lt;b&gt;Consultar el gasto por categoría e identificar la mayor&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-21 · RF-021 · Must Have · MVP&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#DCEEF4;strokeColor=#3F8CA3;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="302" width="560" height="84" as="geometry"/></mxCell>
        <mxCell id="uc-HU-22" value="&lt;b&gt;Comparar el gasto entre periodos&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5E7683'&gt;HU-22 · RF-022 · Could Have&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#17323D;fillColor=#FCF0DC;strokeColor=#C49A5C;strokeWidth=1.6;spacing=3;" vertex="1" parent="1"><mxGeometry x="470" y="410" width="560" height="84" as="geometry"/></mxCell>
