        <mxCell id="legr3" value="&lt;b&gt;Won't Have (for now)&lt;/b&gt; — fuera de esta versión" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=9.5;fontColor=#3B5560;" vertex="1" parent="1"><mxGeometry x="1276" y="362" width="270" height="20" as="geometry"/></mxCell>
        <mxCell id="leg-sep" value="" style="rounded=0;html=1;fillColor=#DCE7EC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1240" y="404" width="280" height="1" as="geometry"/></mxCell>
        <mxCell id="leg-rel" value="&lt;b&gt;«include»&lt;/b&gt; → comportamiento obligatorio reutilizado por otro caso de uso.&lt;br&gt;&lt;b&gt;«extend»&lt;/b&gt; → comportamiento opcional que amplía un caso de uso base.&lt;br&gt;La línea sin flecha une cada actor con sus casos de uso." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#546B78;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1240" y="414" width="292" height="62" as="geometry"/></mxCell>
        <mxCell id="not-panel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF2;strokeColor=#E6D9BB;strokeWidth=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="1220" y="508" width="340" height="468" as="geometry"/></mxCell>
        <mxCell id="not-t" value="&lt;b&gt;Alcance y criterios de lectura&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#5C5236;" vertex="1" parent="1"><mxGeometry x="1240" y="522" width="300" height="22" as="geometry"/></mxCell>
        <mxCell id="b0" value="•   &lt;b&gt;Actores (D-08):&lt;/b&gt; Visitante sin sesión; Usuario autenticado que solo accede a sus datos; Administrador con metadatos y agregados, nunca con gastos individuales." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5C5442;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1240" y="552" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="b1" value="•   &lt;b&gt;Sin generalización entre actores:&lt;/b&gt; el Administrador no hereda los permisos del Usuario; sus casos de uso son independientes." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5C5442;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1240" y="634" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="b2" value="•   &lt;b&gt;Trazabilidad:&lt;/b&gt; cada caso de uso indica su HU y su RF de origen; el color refleja la prioridad de la matriz definitiva 3.0." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5C5442;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1240" y="716" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="b3" value="•   &lt;b&gt;Transversal:&lt;/b&gt; HU-33 / RF-033, RNF-001 y RNF-002 aplican a todo caso de uso privado (autorización y aislamiento por propietario)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5C5442;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1240" y="798" width="300" height="82" as="geometry"/></mxCell>
        <mxCell id="b4" value="•   &lt;b&gt;Servicios externos:&lt;/b&gt; Supabase Auth, Cloudinary y SpeechRecognizer de Android son infraestructura, no actores. El detalle por caso de uso está en las páginas 02 a 05." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=9;fontColor=#5C5442;spacingRight=4;" vertex="1" parent="1"><mxGeometry x="1240" y="880" width="300" height="82" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
